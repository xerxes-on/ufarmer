{
    "name": "ufarm/premium",
    "description": "Premium subscription management package for Ufarm.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/queue": "^10.0|^11.0|^12.0",
        "vladimir-yuldashev/laravel-queue-rabbitmq": "^14.0"
    },
    "autoload": {
        "psr-4": {
            "Ufarm\\Premium\\": "src/"
        },
        "classmap": [
            "database/factories",
            "database/seeders"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Ufarm\\Premium\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ufarm\\Premium\\Providers\\PremiumServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
