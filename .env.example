APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
API_LOCALES=uz,ru,en

# Admin panel SSO (ufarm-auth, application alias: admin_panel)
AUTHBRIDGE_DB_DRIVER=pgsql
AUTHBRIDGE_DB_HOST=127.0.0.1
AUTHBRIDGE_DB_PORT=5432
AUTHBRIDGE_DB_DATABASE=ufarm_auth
AUTHBRIDGE_DB_USERNAME=
AUTHBRIDGE_DB_PASSWORD=

AUTHBRIDGE_SSO_ENABLED=true
AUTHBRIDGE_SSO_BASE_URL=
AUTHBRIDGE_SSO_CLIENT_ID=
AUTHBRIDGE_SSO_CLIENT_SECRET=
AUTHBRIDGE_SSO_REDIRECT_URI=

# UFarm Auth JSON-RPC (findOrCreateUser) — resolves/attaches an SSO auth_id
# for employees created/edited via the Employees resource in this admin panel.
JSONRPC_ENDPOINT=
JSONRPC_USERNAME=
JSONRPC_PASSWORD=
SSO_EMPLOYEE_APPLICATION_ALIAS=admin_panel

# Comma-separated auth_ids auto-granted super_admin on first SSO login.
FILAMENT_SUPER_ADMIN_AUTH_IDS=

# Agronom / Uzgidromet panel allowlist — unrelated to admin_panel SSO, untouched.
ADMIN_PANEL_EMAILS=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

MEDIA_DISK=public
MEDIA_URL=https://api.dev.ufarmer.uz/storage

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Notification Types RPC
NOTIFICATIONS_RPC_ENDPOINT=
NOTIFICATIONS_RPC_USERNAME=
NOTIFICATIONS_RPC_PASSWORD=
NOTIFICATIONS_CACHE_TTL=3600

# Telegram notifications — Uzgidromet upload feed.
# Leave blank to disable; observer silently no-ops when either is unset.
TG_UZGIDROMET_BOT_TOKEN=
TG_UZGIDROMET_CHANNEL_ID=

# Admin panel SSO (ufarm-auth, application alias: admin_panel)
AUTHBRIDGE_DB_DRIVER=pgsql
AUTHBRIDGE_DB_HOST=127.0.0.1
AUTHBRIDGE_DB_PORT=5432
AUTHBRIDGE_DB_DATABASE=ufarm_auth
AUTHBRIDGE_DB_USERNAME=
AUTHBRIDGE_DB_PASSWORD=

AUTHBRIDGE_SSO_ENABLED=true
AUTHBRIDGE_SSO_BASE_URL=
AUTHBRIDGE_SSO_CLIENT_ID=
AUTHBRIDGE_SSO_CLIENT_SECRET=
AUTHBRIDGE_SSO_REDIRECT_URI=

# UFarm Auth JSON-RPC (findOrCreateUser) — resolves/attaches an SSO auth_id
# for employees created/edited via the Employees resource in this admin panel.
JSONRPC_ENDPOINT=
JSONRPC_USERNAME=
JSONRPC_PASSWORD=
SSO_EMPLOYEE_APPLICATION_ALIAS=admin_panel

# Comma-separated auth_ids auto-granted super_admin on first SSO login.
FILAMENT_SUPER_ADMIN_AUTH_IDS=

# Agronom / Uzgidromet panel allowlist — unrelated to admin_panel SSO, untouched.
ADMIN_PANEL_EMAILS=

# Application alias imported service workers are attached to in ufarm-auth.
SSO_WORKER_APPLICATION_ALIAS=in_service

# AI import (UFARM-2644). Stays off until enabled AND a key is present, so an
# unconfigured environment hides the feature rather than failing mid-import.
WORKER_AI_IMPORT_ENABLED=false
OPENROUTER_API_KEY=
# A whole sheet chunk is extracted in one strict-schema call, and a weaker
# model runs out of output space partway through and silently drops the rows
# it never reached (UFARM-2671). Prefer a model that can hold the full chunk.
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_TRANSLATION_RETRY_MODEL=openai/gpt-4.1-mini
# Comma-separated; used as OpenRouter's `route: fallback` chain.
OPENROUTER_FALLBACK_MODELS=
# Output ceiling per call. 0 leaves it to the provider. Too small is now a
# visible failure, not a short answer.
OPENROUTER_MAX_OUTPUT_TOKENS=16000
# Create a service category when a sheet names a service the catalog has no
# word for. Created inactive, so an admin reviews it before customers see it.
OPENROUTER_CATEGORY_CREATION=true
OPENROUTER_MAX_CREATED_CATEGORIES=10

# Dedicated queue for AI import extraction. Leave empty to use the default
# queue, which is what the existing worker already consumes. Only set this
# when a worker is configured to watch the named queue.
AI_IMPORT_QUEUE=
